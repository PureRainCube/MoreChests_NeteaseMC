{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.purerain_chests.chest": {
      "initial_state": "closed",
      "states": {
        "closed": {
          "animations": [
            "closed"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "open": "variable.chest_open"
            }
          ]
        },
        "open": {
          "animations": [
            "open"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "closed": "!variable.chest_open"
            }
          ]
        }
      }
    }
  }
}